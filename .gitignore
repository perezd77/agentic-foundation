# config.yaml is committed so the scheduled workflow can run it (it holds no
# secrets — email credentials come from env vars). Use *.local.yaml for any
# private overrides you don't want tracked.
*.local.yaml
.env

# De-duplication state written at runtime.
.alert_state.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Vendored Revolut X MCP server (built locally via scripts/setup-revolut-x-mcp.sh)
vendor/
